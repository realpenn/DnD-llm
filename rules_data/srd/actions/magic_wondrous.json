    {
      "id": "srd.wear_boots_of_elvenkind",
      "name": "Wear Boots of Elvenkind",
      "localization": {
        "en": "Wear Boots of Elvenkind",
        "zh": "穿戴精灵靴",
        "aliases": ["启用精灵靴"]
      },
      "source": "SRD 5.2.1 Chapter 7: Magic Items A-Z, Boots of Elvenkind",
      "rules_version": "srd-5.2.1",
      "action_type": "item",
      "action_economy": "none",
      "range": { "self": true },
      "target_policy": { "min": 1, "max": 1, "harmful": false },
      "requirements": { "item": "srd.boots_of_elvenkind" },
      "properties": {
        "boots_of_elvenkind": true,
        "requires_attunement": false,
        "worn_slot": "feet"
      },
      "friendly_fire_policy": "raw",
      "automation": [
        { "type": "target", "mode": "explicit" },
        {
          "type": "passive_effect",
          "passive_modifiers": {
            "silent_steps": true,
            "ability_check_advantage_skills": [
              { "ability": "dex", "skill": "stealth" }
            ]
          },
          "duration": { "until": "while_wearing_boots_of_elvenkind" },
          "stacking_policy": "replace"
        },
        { "type": "text_result", "text": "While wearing these boots, the target's steps make no sound and the target has Advantage on Dexterity (Stealth) checks." }
      ],
      "audit_label": "Wear Boots of Elvenkind"
    },
