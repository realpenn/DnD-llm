    {
      "id": "srd.wear_robe_of_the_archmagi",
      "name": "Wear Robe of the Archmagi",
      "localization": {
        "en": "Wear Robe of the Archmagi",
        "zh": "穿戴大法师法袍",
        "aliases": ["启用大法师法袍"]
      },
