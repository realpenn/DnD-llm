        "trigger_spell_definition_id": "srd.spell.light",
        "requires_attunement": true,
        "worn_slot": "body"
      },
      "friendly_fire_policy": "raw",
      "automation": [
        { "type": "target", "mode": "explicit" },
        {
          "type": "condition",
          "condition": "blinded",
          "duration": {
            "until": "duration_1_minute",
            "repeat_save": {
              "ability": "con",
              "dc": 11,
              "dc_source": "dc_ref:srd.robe_of_eyes.light_con_save",
              "end_on_success": true
            }
          },
          "tick_on": "self_turn_end",
          "stacking_policy": "replace"
        },
        { "type": "text_result", "text": "A Light spell cast on the robe gives the wearer the Blinded condition for 1 minute; at the end of each of their turns, they make a DC 11 Constitution saving throw, ending the condition on a success." }
