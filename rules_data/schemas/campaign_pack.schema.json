{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignPack",
  "type": "object",
  "required": ["campaign_id", "title", "version", "rules_version", "start_zone_id", "zones", "outline", "attribution"],
  "properties": {
    "campaign_id": { "type": "string" },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "rules_version": { "type": "string" },
    "start_zone_id": { "type": "string" },
    "zones": { "type": "object" },
    "outline": {
      "type": "object",
      "required": ["mainline", "chapters", "npcs", "objectives", "endings"],
      "properties": {
        "mainline": { "type": "string" },
        "chapters": { "type": "array" },
        "npcs": { "type": "array" },
        "objectives": { "type": "array" },
        "endings": { "type": "array" }
      }
    },
    "encounters": { "type": "object" },
    "rewards": { "type": "object" },
    "events": { "type": "object" },
    "attribution": { "type": "array" }
  }
}
